# =============================================================================
# HALLO Projects — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
DOMAIN=projects.example.com

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://hallo:your_db_password@localhost:5432/hallo_projects
DB_PASSWORD=your_db_password

# -----------------------------------------------------------------------------
# Cache & Queue (Redis)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# API (apps/api)
# -----------------------------------------------------------------------------
PORT=4000

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Encryption key for provider credentials — must be exactly 32 bytes hex
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_32_byte_hex_encryption_key

# GitHub Webhook secret — generate with: openssl rand -hex 20
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Log level: error | warn | info | debug | verbose
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Web (apps/web)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Worker (apps/worker)
# -----------------------------------------------------------------------------
# Health check interval in seconds (default: 60)
HEALTH_CHECK_INTERVAL=60

# Timeout per health check request in seconds (default: 10)
HEALTH_CHECK_TIMEOUT=10

# Polling interval for deployment status in seconds (default: 5)
DEPLOYMENT_POLL_INTERVAL=5
